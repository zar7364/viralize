SUMOPOD_API_KEY=your-sumopod-api-key
FIRECRAWL_API_KEY=your-firecrawl-api-key

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

ALLOWED_EMAILS=you@example.com

# Origin frontend yang diizinkan CORS, dipisah koma (Vite dev server)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Calendar per-user (OAuth client tipe "Web application", beda dari
# gcp-oauth-keys.json yang tipe "Desktop app")
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_CALENDAR_OAUTH_REDIRECT_URI=http://localhost:8001/api/calendar/oauth/callback
FRONTEND_URL=http://localhost:5173

# Project Settings -> API -> service_role di Supabase dashboard. HANYA untuk
# backend, jangan pernah taruh di frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
