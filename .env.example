SUMOPOD_API_KEY=your-sumopod-api-key
FIRECRAWL_API_KEY=your-firecrawl-api-key

# --- Web app / login gate config ---
# Login dipegang frontend (Supabase Auth + Google OAuth di
# Viralist/src/components/Login.tsx). Backend ini cuma memverifikasi
# access token Supabase yang dikirim tiap request, jadi butuh URL + anon key
# project Supabase yang SAMA dengan Viralist/.env.local.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Daftar email yang boleh akses API, dipisah koma (gerbang akses, bukan auth Calendar)
ALLOWED_EMAILS=you@example.com

# Origin frontend yang diizinkan CORS, dipisah koma (Vite dev server)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
